# FiberMind 配置模板。复制为 .env 后按需修改；.env 已被 .gitignore 排除，不要提交真实 Key。

APP_ENV=demo
APP_HOST=127.0.0.1
APP_PORT=8000
LOG_LEVEL=INFO

# --- 后端选择（memory/local/grounded 为零依赖 baseline）---
CACHE_BACKEND=memory
SESSION_BACKEND=memory
RETRIEVAL_BACKEND=memory
RERANK_BACKEND=local
INTENT_BACKEND=rule

# --- Redis：仅做答案缓存（Session 与历史走 MySQL）---
# CACHE_BACKEND=redis
REDIS_URL=redis://localhost:6379/0
CACHE_TTL_SECONDS=600

# --- MySQL：持久化 Session 与多轮历史 ---
# SESSION_BACKEND=mysql
MYSQL_DSN=mysql+pymysql://fibermind:fibermind@localhost:3306/fibermind

# --- LLM（OpenAI-compatible）---
LLM_BACKEND=grounded
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
LLM_TIMEOUT_SECONDS=60

# LLM 可用时 Query 优化（Rewrite/HyDE/Sub-Query）也走 LLM；false 则始终用规则版
REWRITE_USE_LLM=true

# --- 混合检索权重（两者都须 >=0 且和 >0，启动时校验并归一化）---
DENSE_WEIGHT=0.55
SPARSE_WEIGHT=0.45
RETRIEVAL_TOP_K=8
RERANK_TOP_N=4

# --- 意图路由阈值（配置化，勿在代码里硬编码）---
INTENT_CONFIDENCE_THRESHOLD=0.55
ROUTER_STANDARD_MIN_CONFIDENCE=0.75
# BERT 推理异常时是否降级 Rule 分类器（false=直接抛错）
INTENT_FALLBACK_ON_ERROR=true

# --- BERT 意图模型 ---
# INTENT_BACKEND=bert
INTENT_MODEL_PATH=models/intent-bert

# --- 检索 / 精排模型（需要 ml + infra extra）---
# RETRIEVAL_BACKEND=milvus
MILVUS_URI=http://localhost:19530
MILVUS_COLLECTION=fiber_knowledge_chunks
EMBEDDING_MODEL=BAAI/bge-m3
# RERANK_BACKEND=bge
RERANK_MODEL=BAAI/bge-reranker-v2-m3

# --- 远程 BGE API（无需本地 torch；Sparse 为词法分量并在响应中如实标注）---
# RETRIEVAL_BACKEND=bge_api
# RERANK_BACKEND=bge_api
# EMBEDDING_BACKEND=bge_api
EMBEDDING_BASE_URL=https://api.siliconflow.cn/v1
EMBEDDING_API_KEY=
EMBEDDING_TIMEOUT_SECONDS=60

# --- RAGAS Judge（Judge LLM 与 Embedding 分开配置）---
RAGAS_LLM_BASE_URL=https://api.openai.com/v1
RAGAS_LLM_API_KEY=
RAGAS_LLM_MODEL=gpt-4o-mini
RAGAS_EMBEDDING_BASE_URL=https://api.siliconflow.cn/v1
RAGAS_EMBEDDING_API_KEY=
RAGAS_EMBEDDING_MODEL=BAAI/bge-m3
RAGAS_TIMEOUT_SECONDS=300
RAGAS_MAX_RETRIES=3
